generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  HOST
  ADMIN
  TEACHER
  PARTICIPANT
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostedClassrooms      Classroom[]            @relation("ClassroomHost")
  memberships           ClassroomMember[]
  classroomJoinRequests ClassroomJoinRequest[]
  dailyGoals            DailyGoal[]
  dailyReflections      DailyReflection[]
}

model Classroom {
  id          String   @id @default(uuid())
  name        String
  description String?
  joinCode    String   @unique
  hostId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  dailyGoal       String?
  goalSettingTime String?
  reflectionTime  String?
  tasksPerDay     Int      @default(5)

  host             User                   @relation("ClassroomHost", fields: [hostId], references: [id])
  members          ClassroomMember[]
  joinRequests     ClassroomJoinRequest[]
  dailyGoals       DailyGoal[]
  dailyReflections DailyReflection[]
}

model ClassroomMember {
  id          String     @id @default(uuid())
  userId      String
  classroomId String
  role        MemberRole @default(PARTICIPANT)
  joinedAt    DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([userId, classroomId])
}

model ClassroomJoinRequest {
  id          String            @id @default(uuid())
  userId      String
  classroomId String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([userId, classroomId])
  @@index([classroomId, status])
}

model DailyGoal {
  id          String   @id @default(uuid())
  userId      String
  classroomId String
  date        DateTime @default(now()) @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id])
  classroom Classroom       @relation(fields: [classroomId], references: [id])
  tasks     DailyGoalTask[]

  @@unique([userId, classroomId, date])
  @@index([classroomId, date])
}

model DailyGoalTask {
  id          String   @id @default(uuid())
  dailyGoalId String
  title       String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  dailyGoal DailyGoal @relation(fields: [dailyGoalId], references: [id], onDelete: Cascade)

  @@index([dailyGoalId])
}

model DailyReflection {
  id          String   @id @default(uuid())
  userId      String
  classroomId String
  date        DateTime @default(now()) @db.Date
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([userId, classroomId, date])
  @@index([classroomId, date])
}
