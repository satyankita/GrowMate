generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  HOST
  ADMIN
  TEACHER
  PARTICIPANT
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  passwordHash String?
  name      String
  email     String   @unique
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostedClassrooms      Classroom[]                 @relation("ClassroomHost")
  memberships           ClassroomMember[]
  classroomJoinRequests ClassroomJoinRequest[]
  dailyGoals            DailyGoal[]
  dailyReflections      DailyReflection[]
  notificationsCreated  ClassroomNotification[]     @relation("NotificationAuthor")
  notificationReads     ClassroomNotificationRead[]
}

model Classroom {
  id          String   @id @default(uuid())
  name        String
  description String?
  joinCode    String   @unique
  hostId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dailyGoal       String?
  goalSettingTime String?
  reflectionTime  String?
  tasksPerDay       Int     @default(5)
  dayParts          Json?
  timezone          String  @default("Asia/Kolkata")
  allowLateGoalEdits Boolean @default(false)

  host             User                    @relation("ClassroomHost", fields: [hostId], references: [id])
  members          ClassroomMember[]
  joinRequests     ClassroomJoinRequest[]
  dailyGoals       DailyGoal[]
  dailyReflections DailyReflection[]
  notifications    ClassroomNotification[]
}

model ClassroomMember {
  id          String     @id @default(uuid())
  userId      String
  classroomId String
  role        MemberRole @default(PARTICIPANT)
  joinedAt    DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([userId, classroomId])
}

model ClassroomJoinRequest {
  id          String            @id @default(uuid())
  userId      String
  classroomId String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([userId, classroomId])
  @@index([classroomId, status])
}

model DailyGoal {
  id          String   @id @default(uuid())
  userId      String
  classroomId String
  date        DateTime @default(now()) @db.Date
  statement   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id])
  classroom Classroom       @relation(fields: [classroomId], references: [id])
  tasks     DailyGoalTask[]

  @@unique([userId, classroomId, date])
  @@index([classroomId, date])
}

model DailyGoalTask {
  id          String   @id @default(uuid())
  dailyGoalId String
  title       String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  dailyGoal DailyGoal @relation(fields: [dailyGoalId], references: [id], onDelete: Cascade)

  @@index([dailyGoalId])
}

model DailyReflection {
  id          String   @id @default(uuid())
  userId      String
  classroomId String
  date        DateTime @default(now()) @db.Date
  content     String
  assessmentScore   Int?
  assessmentCorrect Int?
  assessmentTotal   Int?
  assessmentDetails Json?
  assessedAt        DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([userId, classroomId, date])
  @@index([classroomId, date])
}

model ClassroomNotification {
  id             String   @id @default(uuid())
  classroomId    String
  createdById    String?
  recipientEmail String?
  type           String   @default("ANNOUNCEMENT")
  title          String
  content        String
  createdAt      DateTime @default(now())

  classroom Classroom                   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy User?                       @relation("NotificationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  reads     ClassroomNotificationRead[]

  @@index([classroomId, createdAt])
  @@index([recipientEmail])
}

model ClassroomNotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification ClassroomNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}
